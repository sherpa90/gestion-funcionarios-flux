# Configuración de Producción - Copia este archivo como .env

# Base de datos
DB_NAME=gestion_funcionarios_prod
DB_USER=gestion_user
DB_PASSWORD=tu_password_seguro_aqui
DB_HOST=localhost
DB_PORT=5432

# Django
SECRET_KEY=tu_secret_key_muy_segura_aqui
DJANGO_SETTINGS_MODULE=config.settings_production
DEBUG=False

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion
DEFAULT_FROM_EMAIL=no-responder@losalercespuertomontt.cl

# Dominio
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# Google OAuth (Google Workspace)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Opcional: Redis para sesiones
REDIS_URL=redis://localhost:6379/0

# Opcional: Configuración de backups
BACKUP_DIR=/home/sherpa/backups
BACKUP_RETENTION_DAYS=30